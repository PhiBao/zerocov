# Environment variables for ExpenseFlow API
# Copy this file to .env and fill in real values for production.
# For tests, these are set automatically in tests/setup.ts

# JWT configuration
JWT_SECRET=change-this-to-a-strong-random-secret-in-production
JWT_REFRESH_SECRET=change-this-to-a-different-strong-secret-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Server
PORT=3000
NODE_ENV=development
